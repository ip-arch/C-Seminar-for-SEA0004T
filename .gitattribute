# 配布 zip（git archive）に含めないもの
.github/          export-ignore
.gitattributes    export-ignore
.gitignore        export-ignore

# 改行コードの扱い
* text=auto
*.c      text
*.h      text
*.txt    text
*.md     text
*.cmake  text
CMakeLists.txt text
CMakePresets.json text
*.sh     text eol=lf
*.yml    text eol=lf

# バイナリ（改行変換をしない）
*.png    binary
*.jpg    binary
*.zip    binary
*.exe    binary
